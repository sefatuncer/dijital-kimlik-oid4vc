<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Memur Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="portal-header mb-4">
        <div class="container d-flex align-items-center justify-content-between py-3">
            <a class="portal-brand" asp-controller="Home" asp-action="Index">
                <span class="portal-mark" aria-hidden="true">DG</span>
                <span>
                    <strong>Demo Göç Kurumu</strong>
                    <small class="d-block">Memur Portalı · Kimlik bilgisi düzenleyici</small>
                </span>
            </a>
            <nav class="d-flex gap-3 small">
                <a asp-controller="Home" asp-action="Index">Panel</a>
                <a href="~/.well-known/openid-credential-issuer" target="_blank">Metadata</a>
            </nav>
        </div>
    </header>
    <main class="container pb-5">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="portal-footer">
        <div class="container small">
            Referans uygulama: OpenID4VCI 1.0 · SD-JWT VC · Token Status List. Kayıtlardaki kişiler hayalidir.
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
