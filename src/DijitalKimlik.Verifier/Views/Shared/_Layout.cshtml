<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Demo Doğrulayıcı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="verifier-header mb-4">
        <div class="container d-flex align-items-center justify-content-between py-3">
            <a class="verifier-brand" asp-controller="Home" asp-action="Index">
                <span class="verifier-mark" aria-hidden="true">✓</span>
                <span>
                    <strong>Demo Doğrulayıcı</strong>
                    <small class="d-block">OpenID4VP · otel resepsiyonu ve yaş kontrolü örnekleri</small>
                </span>
            </a>
        </div>
    </header>
    <main class="container pb-5">
        @RenderBody()
    </main>
    <footer class="verifier-footer">
        <div class="container small">
            Referans uygulama: OpenID4VP 1.0 · DCQL · SD-JWT VC · Token Status List. Doğrulayıcı kişisel veriyi saklamaz.
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
