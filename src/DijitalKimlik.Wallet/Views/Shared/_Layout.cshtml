<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Demo Cüzdan</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="phone">
        <header class="phone-bar">
            <a asp-controller="Home" asp-action="Index" class="phone-title">Demo Cüzdan</a>
            <span class="phone-sub">Web cüzdanı · OpenID4VCI / OpenID4VP</span>
        </header>
        <main class="phone-body">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success py-2">@message</div>
            }
            @RenderBody()
        </main>
    </div>
</body>
</html>
